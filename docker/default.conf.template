server {
  listen ${PORT};
  root /usr/share/nginx/html;
  index index.html;

  location = /health { access_log off; default_type text/plain; return 200 "ok\n"; }

  # SPA: rotas do React caem no index.html
  location / { try_files $uri $uri/ /index.html; }

  # Nunca cachear o que controla atualização e configuração
  location = /index.html { add_header Cache-Control "no-cache"; }
  location = /config.js { add_header Cache-Control "no-store"; }
  location = /sw.js { add_header Cache-Control "no-cache"; }
  location = /manifest.webmanifest { add_header Cache-Control "no-cache"; }

  # Assets versionados (hash no nome) podem ficar em cache longo
  location /assets/ { add_header Cache-Control "public, max-age=31536000, immutable"; }

  add_header X-Content-Type-Options nosniff always;
  add_header Referrer-Policy strict-origin-when-cross-origin always;
  add_header X-Frame-Options SAMEORIGIN always;
  gzip on;
  gzip_types text/css application/javascript application/json image/svg+xml;
}
