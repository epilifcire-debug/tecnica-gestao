# =====================================================================
# Técnica Engenharia — variáveis da Aplicação na Shard Cloud
# Cole cada linha em: Aplicação → Variáveis de ambiente
# Supabase → Project Settings → API
# =====================================================================

# URL do projeto Supabase (Project URL)
SUPABASE_URL=https://SEU-PROJETO.supabase.co

# Chave PÚBLICA "anon" / "publishable" (pode ficar no navegador — a segurança é a RLS)
SUPABASE_ANON_KEY=COLE_AQUI_A_ANON_KEY

# Porta (opcional). O app já escuta na 80, que é a que a Shard usa para sites.
# PORT=80

# NÃO coloque aqui a service_role key. Ela fica só nas Edge Functions do Supabase.
